{
  "name": "kontakt-home",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "api": "uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8010",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:clear": "node -e \"const fs=require('fs');const p='data/db';if(fs.existsSync(p))fs.readdirSync(p).filter(f=>f.endsWith('.json')).forEach(f=>fs.unlinkSync(p+'/'+f));console.log('db cleared')\""
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
